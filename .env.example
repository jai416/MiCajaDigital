# ============================================================
# Mi Caja Digital — Panel Admin (Next.js + Supabase)
# Copia este archivo como .env.local y completa los valores.
# .env.local NO se sube al repositorio (ver .gitignore).
# ============================================================

# URL y clave ANON pública del proyecto Supabase (Settings → API)
# Son públicas por diseño (la anon key es read-only según RLS).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Clave de SERVICIO (service_role) — SOLO en server side. ¡Nunca en el cliente!
# NO pongas el valor real aquí; pégalo en .env.local.
# Alternativa recomendada en producción: Supabase Vault
#   https://supabase.com/docs/guides/database/vault
#   1. SQL Editor:
#      CREATE EXTENSION IF NOT EXISTS supabase_vault;
#      SELECT vault.create_secret('TU_SERVICE_ROLE', 'supabase_service_role_key');
#   2. Luego referencia el secreto con vault.decrypted_secrets / una función
#      SECURITY DEFINER para leerlo solo server-side sin exponerlo.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Credenciales de acceso al panel admin (cámbialas en producción)
ADMIN_EMAIL=admin@micajadigital.cu
# Contraseña plana (compatibilidad). RECOMENDADO: usa el hash scrypt abajo.
ADMIN_PASSWORD=una_contraseña_fuerte
# Hash scrypt de la contraseña (se prefiere sobre ADMIN_PASSWORD). Genera con:
#   node scripts/hash_password.mjs "tu_contraseña"
# Ejemplo (formato): scrypt$16384$8$1$<salt_hex>:<hash_hex>
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...

# OBLIGATORIO (fail-fast): clave larga y aleatoria para firmar la sesión.
# Sin ella el panel NO emite sesiones (lib/session.ts lanza un error).
# Genera una con:  openssl rand -hex 64
ADMIN_SESSION_SECRET=cadena_larga_y_secreta_para_firmar_la_sesion
# Versión del esquema de sesión. Súbela (v1 -> v2) para invalidar TODAS las
# sesiones existentes (tras un compromiso o cambio de contraseña).
ADMIN_SESSION_VERSION=v1

# OTA (/api/version): versión de la app que anuncia el panel. Debe coincidir
# con pubspec.yaml + lib/core/utils/constants.dart (APP_VERSION/APP_VERSION_CODE).
APP_VERSION=1.3.4
APP_VERSION_CODE=2022

# OTA: enlace de descarga del APK (APKPure u otro). Si no se define, el
# endpoint /api/version hace fallback al contrato hardcodeado.
APK_DOWNLOAD_URL=https://apkpure.com/p/com.tunegocio.micajadigital.app

# ============================================================
# Notificaciones Telegram (vía Cloudflare Worker proxy)
# Cuba bloquea api.telegram.org → todas las llamadas pasan por el Worker.
# ============================================================
# URL base del Worker proxy.
# ⚠️ SIN barra final: con `/` se duplica el path y Telegram responde 404.
# ⚠️ Debe ser el worker de Telegram, no otro con nombre parecido
#    (ronda 22: apuntaba a otro worker y el bot no respondía).
TELEGRAM_PROXY_URL=https://tu-worker.workers.dev
# Token del bot de Telegram (obtenido de @BotFather). Si se filtra:
# /revoke en BotFather, propagar a .env.local + Render y RE-REGISTRAR
# setWebhook + setMyCommands con el token nuevo.
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
# Chat ID privado del admin (número entero, sin @). Se obtiene del grupo o
# con getUpdates. El bot SOLO responde a este chat.
TELEGRAM_CHAT_ID=tu_chat_id_aqui
# Secreto compartido para dos usos:
#  1. Protege el endpoint /api/cron/notificaciones (Authorization: Bearer)
#  2. Protege el webhook del bot /api/bot/webhook (secret_token de Telegram)
# ⚠️ Si falta, AMBOS endpoints fallan cerrados (no responden a nadie).
# Generar con: openssl rand -hex 32
CRON_SECRET=tu_cron_secret_aqui
