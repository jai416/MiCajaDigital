{
  "expo": {
    "name": "Mi Caja Digital",
    "slug": "micajadigital",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "micajadigital",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tunegocio.micajadigital"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "package": "com.tunegocio.micajadigital",
      "versionCode": 2,
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "android.intent.action.VIEW",
          "data": {
            "scheme": "micajadigital",
            "host": "*",
            "pathPrefix": "/ventas"
          },
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#059669"
        }
      ],
      "expo-sharing",
      "expo-image-picker",
      "expo-secure-store",
      "expo-background-fetch",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21995d8b-8a6b-412d-a49f-7480a05e946d"
      }
    },
    "owner": "jai416s-team"
  }
}
