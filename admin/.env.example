# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

# URL de tu proyecto Supabase (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon (pública, se usa solo para operaciones sin service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key_publica_aqui

# Service role key (SECRETA, solo server-side, NUNCA en el bundle del móvil)
SUPABASE_SERVICE_ROLE_KEY=service_role_key_secreta_aqui

# Credenciales del panel admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esta_contrasena
